---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for post in site.posts -%}
{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":"{{ post.date | date: '%Y-%m-%d' }}","label":{{ post.date | date: "%-d %b %Y" | upcase | jsonify }},"summary":{{ post.summary | default: post.description | default: post.excerpt | strip_html | strip_newlines | truncatewords: 40 | jsonify }},"tags":{{ post.tags | jsonify }},"content":{{ post.content | strip_html | strip_newlines | truncatewords: 400 | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
